<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ar3_bringup</name>
  <version>0.0.1</version>
  <description>Bringup package for AR3 robot arm with ROS2 Control and MoveIt integration</description>
  <maintainer email="sadasd@qq.com">bigjelly</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ar3_description</depend>
  <depend>ar3_hardware_interface</depend>
  <depend>gazebo_ros2_control</depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>rviz2</exec_depend>
  


  <!-- Launch文件依赖 -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <launch>
      <launch-prefix>bash -c '</launch-prefix>
      <launch-suffix>'</launch-suffix>
    </launch>
  </export>
</package>