<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- AR3关节的实际限制（弧度） -->
  <xacro:property name="joint_1_min" value="-2.7925" />  <!-- -160度 -->
  <xacro:property name="joint_1_max" value="2.7925" />   <!-- 160度 -->
  
  <xacro:property name="joint_2_min" value="-1.9199" />  <!-- -110度 -->
  <xacro:property name="joint_2_max" value="1.9199" />   <!-- 110度 -->
  
  <xacro:property name="joint_3_min" value="-1.9199" />  <!-- -110度 -->
  <xacro:property name="joint_3_max" value="1.9199" />   <!-- 110度 -->
  
  <xacro:property name="joint_4_min" value="-1.9199" />  <!-- -110度 -->
  <xacro:property name="joint_4_max" value="1.9199" />   <!-- 110度 -->
  
  <xacro:property name="joint_5_min" value="-1.9199" />  <!-- -110度 -->
  <xacro:property name="joint_5_max" value="1.9199" />   <!-- 110度 -->
  
  <xacro:property name="joint_6_min" value="-1.9199" />  <!-- -110度 -->
  <xacro:property name="joint_6_max" value="1.9199" />   <!-- 110度 -->

  <!-- 带限制的关节宏 -->
  <xacro:macro name="ar3_revolute_joint" params="name parent child origin_xyz origin_rpy axis_xyz">
    <joint name="${name}" type="revolute">
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}" />
      <parent link="${parent}" />
      <child link="${child}" />
      <axis xyz="${axis_xyz}" />
      <!-- 使用实际的关节限制 -->
      <xacro:if value="${name == 'joint_1'}">
        <limit lower="${joint_1_min}" upper="${joint_1_max}" effort="10.0" velocity="2.0"/>
      </xacro:if>
      <xacro:if value="${name == 'joint_2'}">
        <limit lower="${joint_2_min}" upper="${joint_2_max}" effort="10.0" velocity="2.0"/>
      </xacro:if>
      <xacro:if value="${name == 'joint_3'}">
        <limit lower="${joint_3_min}" upper="${joint_3_max}" effort="10.0" velocity="2.0"/>
      </xacro:if>
      <xacro:if value="${name == 'joint_4'}">
        <limit lower="${joint_4_min}" upper="${joint_4_max}" effort="10.0" velocity="2.0"/>
      </xacro:if>
      <xacro:if value="${name == 'joint_5'}">
        <limit lower="${joint_5_min}" upper="${joint_5_max}" effort="10.0" velocity="2.0"/>
      </xacro:if>
      <xacro:if value="${name == 'joint_6'}">
        <limit lower="${joint_6_min}" upper="${joint_6_max}" effort="10.0" velocity="2.0"/>
      </xacro:if>
    </joint>
  </xacro:macro>

</robot>