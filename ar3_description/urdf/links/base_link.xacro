<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="base_link">
    <link name="base_link">
      <inertial>
        <origin xyz="-4.6941E-06 0.054174 0.038824" rpy="0 0 0" />
        <mass value="0.7102" />
        <inertia 
          ixx="0.0039943" ixy="3.697E-07" ixz="-5.7364E-08" 
          iyy="0.0014946" iyz="-0.00036051" izz="0.0042554" />
      </inertial>
      
      <!-- 视觉部分：仍使用精细 STL 网格 -->
      <visual>
        <geometry>
          <mesh filename="package://ar3_description/meshes/base_link.STL" />
        </geometry>
        <material name="aluminum_dark" />
      </visual>

      <!-- 碰撞部分：简化为长方体（AABB 参数） -->
      <collision>
        <origin xyz="0.000000 0.047665 0.062175" rpy="0 0 0"/>
        <geometry>
          <box size="0.149953 0.244670 0.124350"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

</robot>