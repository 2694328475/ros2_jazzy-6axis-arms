<?xml version="1.0"?>
<package format="3">
  <name>ar3_hardware_interface</name>
  <version>0.0.1</version>
  <description>ROS2 hardware interface for AR3 robot arm (Open-loop control)</description>
  <maintainer email="your-email@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_ros</buildtool_depend>
  <depend>pluginlib</depend>

  <exec_depend>control_msgs</exec_depend>
  <exec_depend>controller_interface</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>rclcpp_lifecycle</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <depend>std_srvs</depend>
  <exec_depend>std_msgs</exec_depend>

  <depend>ar3_hardware_drivers</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/ar3_hardware_interface.xml" />
  </export>
</package>